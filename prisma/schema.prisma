generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AdminUserStatus {
  active
  disabled

  @@map("admin_user_status")
}

enum ProductStatus {
  active
  hidden
  archived

  @@map("product_status")
}

enum OrderStatus {
  new
  confirmed
  preparing
  shipping
  completed
  cancelled

  @@map("order_status")
}

enum ChatChannel {
  web
  messenger

  @@map("chat_channel")
}

enum ChatMessageDeliveryStatus {
  delivered
  pending
  sent
  failed

  @@map("chat_message_delivery_status")
}

enum IntegrationStatus {
  active
  disconnected
  error

  @@map("integration_status")
}

enum WebhookEventStatus {
  processed
  ignored
  failed

  @@map("webhook_event_status")
}

enum OutboundMessageStatus {
  pending
  sent
  failed
  dead_letter

  @@map("outbound_message_status")
}

enum ShopMemberRole {
  owner
  staff

  @@map("shop_member_role")
}

enum ShopMembershipStatus {
  active
  revoked

  @@map("shop_membership_status")
}

enum AiInteractionOutcome {
  answered_grounded
  handoff_human_requested
  handoff_low_confidence
  blocked_unverified_price
  blocked_forbidden_claim
  fallback_disabled_or_budget
  provider_error

  @@map("ai_interaction_outcome")
}

enum ChatSessionStatus {
  open
  waiting_shop
  waiting_customer
  closed

  @@map("chat_session_status")
}

enum ChatHandlingMode {
  bot
  human

  @@map("chat_handling_mode")
}

enum ChatSenderType {
  customer
  bot
  admin
  system

  @@map("chat_sender_type")
}

model Shop {
  id                 String   @id @default(uuid()) @db.Uuid
  slug               String   @unique(map: "shops_slug_key") @default(uuid()) @db.VarChar(64)
  name               String   @db.VarChar(120)
  publicPhone        String?  @map("public_phone") @db.VarChar(40)
  publicAddress      String?  @map("public_address") @db.VarChar(500)
  timezone           String   @default("Asia/Ho_Chi_Minh") @db.VarChar(64)
  currency           String   @default("VND") @db.Char(3)
  botName            String   @map("bot_name") @db.VarChar(60)
  fallbackReply      String   @map("fallback_reply") @db.VarChar(1000)
  aiEnabled          Boolean  @default(false) @map("ai_enabled")
  aiChannels         String[] @default(["web"]) @map("ai_channels")
  aiDailyTokenBudget Int      @default(50000) @map("ai_daily_token_budget")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  adminUsers          AdminUser[]
  activeSessions      AdminSession[]       @relation("ActiveShopSessions")
  memberships         ShopMembership[]
  invitations         ShopInvitation[]
  auditLogs           AuditLog[]
  aiInteractionLogs   AiInteractionLog[]
  products            Product[]
  botRules            BotRule[]
  orders              Order[]
  orderItems          OrderItem[]
  orderEvents         OrderEvent[]
  chatSessions        ChatSession[]
  chatMessages        ChatMessage[]
  chatNotes           ChatNote[]
  chatSessionEvents   ChatSessionEvent[]
  channelIntegrations ChannelIntegration[]
  webhookEvents       WebhookEvent[]
  outboundMessages    OutboundMessage[]

  @@map("shops")
}

model AdminUser {
  id              String          @id @default(uuid()) @db.Uuid
  shopId          String          @map("shop_id") @db.Uuid
  emailNormalized String          @map("email_normalized") @db.VarChar(254)
  passwordHash    String          @map("password_hash")
  status          AdminUserStatus @default(active)
  lastLoginAt     DateTime?       @map("last_login_at") @db.Timestamptz(6)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  shop              Shop               @relation(fields: [shopId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  sessions          AdminSession[]
  memberships       ShopMembership[]   @relation("UserMemberships")
  sentInvitations   ShopInvitation[]   @relation("InvitedByAdmin")
  auditLogs         AuditLog[]
  orderEvents       OrderEvent[]
  chatMessages      ChatMessage[]
  chatNotes         ChatNote[]
  chatSessionEvents ChatSessionEvent[]

  @@unique([shopId, emailNormalized], map: "admin_users_shop_email_key")
  @@map("admin_users")
}

model AdminSession {
  id               String    @id @default(uuid()) @db.Uuid
  adminUserId      String    @map("admin_user_id") @db.Uuid
  activeShopId     String?   @map("active_shop_id") @db.Uuid
  sessionTokenHash Bytes     @unique(map: "admin_sessions_token_hash_key") @map("session_token_hash") @db.ByteA
  csrfTokenHash    Bytes     @map("csrf_token_hash") @db.ByteA
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt       DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)

  adminUser  AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  activeShop Shop?     @relation("ActiveShopSessions", fields: [activeShopId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([adminUserId], map: "admin_sessions_user_idx")
  @@map("admin_sessions")
}

model Product {
  id          String        @id @default(uuid()) @db.Uuid
  shopId      String        @map("shop_id") @db.Uuid
  name        String        @db.VarChar(160)
  description String?       @db.VarChar(1000)
  priceVnd    BigInt        @map("price_vnd")
  emoji       String?       @db.VarChar(16)
  status      ProductStatus @default(active)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  shop       Shop        @relation(fields: [shopId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  orderItems OrderItem[]

  @@index([shopId, status, name], map: "products_shop_status_name_idx")
  @@map("products")
}

model BotRule {
  id        String   @id @default(uuid()) @db.Uuid
  shopId    String   @map("shop_id") @db.Uuid
  keywords  String[]
  answer    String   @db.VarChar(1000)
  priority  Int      @default(100)
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([shopId, enabled, priority], map: "bot_rules_shop_enabled_priority_idx")
  @@map("bot_rules")
}

model Order {
  id                 String      @id @default(uuid()) @db.Uuid
  shopId             String      @map("shop_id") @db.Uuid
  orderNo            String      @map("order_no") @db.VarChar(40)
  status             OrderStatus @default(new)
  recipientName      String      @map("recipient_name") @db.VarChar(120)
  recipientPhone     String      @map("recipient_phone") @db.VarChar(32)
  recipientPhoneNorm String      @map("recipient_phone_norm") @db.VarChar(32)
  shippingAddress    String      @map("shipping_address") @db.VarChar(500)
  customerNote       String?     @map("customer_note") @db.VarChar(1000)
  subtotalVnd        BigInt      @map("subtotal_vnd")
  shippingFeeVnd     BigInt?     @map("shipping_fee_vnd")
  totalVnd           BigInt?     @map("total_vnd")
  idempotencyKey     String      @map("idempotency_key") @db.VarChar(128)
  requestFingerprint Bytes       @map("request_fingerprint") @db.ByteA
  createdAt          DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  shop   Shop         @relation(fields: [shopId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  items  OrderItem[]
  events OrderEvent[]

  @@unique([shopId, orderNo], map: "orders_shop_order_no_key")
  @@unique([shopId, idempotencyKey], map: "orders_shop_idempotency_key")
  @@unique([id, shopId], map: "orders_id_shop_key")
  @@index([shopId, createdAt(sort: Desc)], map: "orders_shop_created_desc_idx")
  @@index([shopId, status, createdAt(sort: Desc)], map: "orders_shop_status_created_desc_idx")
  @@index([shopId, recipientPhoneNorm], map: "orders_shop_phone_norm_idx")
  @@map("orders")
}

model OrderItem {
  id                  String  @id @default(uuid()) @db.Uuid
  shopId              String  @map("shop_id") @db.Uuid
  orderId             String  @map("order_id") @db.Uuid
  productId           String? @map("product_id") @db.Uuid
  productNameSnapshot String  @map("product_name_snapshot") @db.VarChar(160)
  unitPriceVnd        BigInt  @map("unit_price_vnd")
  quantity            Int
  lineTotalVnd        BigInt  @map("line_total_vnd")

  shop    Shop     @relation(fields: [shopId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  order   Order    @relation(fields: [orderId, shopId], references: [id, shopId], onDelete: Restrict, onUpdate: Restrict)
  product Product? @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([orderId], map: "order_items_order_idx")
  @@map("order_items")
}

model OrderEvent {
  id               String       @id @default(uuid()) @db.Uuid
  shopId           String       @map("shop_id") @db.Uuid
  orderId          String       @map("order_id") @db.Uuid
  actorAdminUserId String?      @map("actor_admin_user_id") @db.Uuid
  eventType        String       @map("event_type") @db.VarChar(64)
  oldStatus        OrderStatus? @map("old_status")
  newStatus        OrderStatus? @map("new_status")
  note             String?      @db.VarChar(1000)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  shop       Shop       @relation(fields: [shopId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  order      Order      @relation(fields: [orderId, shopId], references: [id, shopId], onDelete: Restrict, onUpdate: Restrict)
  actorAdmin AdminUser? @relation(fields: [actorAdminUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([orderId, createdAt], map: "order_events_order_created_idx")
  @@map("order_events")
}

model ChatSession {
  id                 String            @id @default(uuid()) @db.Uuid
  shopId             String            @map("shop_id") @db.Uuid
  channel            ChatChannel       @default(web)
  integrationId      String?           @map("integration_id") @db.Uuid
  externalUserId     String?           @map("external_user_id") @db.VarChar(128)
  visitorTokenHash   Bytes?            @unique(map: "chat_sessions_visitor_token_hash_key") @map("visitor_token_hash") @db.ByteA
  visitorName        String?           @map("visitor_name") @db.VarChar(120)
  visitorPhone       String?           @map("visitor_phone") @db.VarChar(32)
  visitorPhoneNorm   String?           @map("visitor_phone_norm") @db.VarChar(32)
  status             ChatSessionStatus @default(open)
  handlingMode       ChatHandlingMode  @default(bot) @map("handling_mode")
  unreadForShop      Int               @default(0) @map("unread_for_shop")
  lastMessageAt      DateTime          @default(now()) @map("last_message_at") @db.Timestamptz(6)
  lastMessagePreview String?           @map("last_message_preview") @db.VarChar(160)
  expiresAt          DateTime          @map("expires_at") @db.Timestamptz(6)
  closedAt           DateTime?         @map("closed_at") @db.Timestamptz(6)
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  shop             Shop                @relation(fields: [shopId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  integration      ChannelIntegration? @relation(fields: [integrationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  messages         ChatMessage[]
  notes            ChatNote[]
  events           ChatSessionEvent[]
  outboundMessages OutboundMessage[]

  @@unique([id, shopId], map: "chat_sessions_id_shop_key")
  @@unique([shopId, channel, externalUserId], map: "chat_sessions_shop_channel_ext_user_key")
  @@index([shopId, lastMessageAt(sort: Desc), id(sort: Desc)], map: "chat_sessions_shop_last_msg_idx")
  @@index([shopId, status, lastMessageAt(sort: Desc), id(sort: Desc)], map: "chat_sessions_shop_status_last_msg_idx")
  @@index([shopId, visitorPhoneNorm], map: "chat_sessions_shop_phone_norm_idx")
  @@map("chat_sessions")
}

model ChatMessage {
  id                 String                    @id @default(uuid()) @db.Uuid
  shopId             String                    @map("shop_id") @db.Uuid
  chatSessionId      String                    @map("chat_session_id") @db.Uuid
  senderType         ChatSenderType            @map("sender_type")
  actorAdminUserId   String?                   @map("actor_admin_user_id") @db.Uuid
  body               String                    @db.VarChar(2000)
  idempotencyKey     String?                   @map("idempotency_key") @db.VarChar(128)
  requestFingerprint Bytes?                    @map("request_fingerprint") @db.ByteA
  providerMessageId  String?                   @map("provider_message_id") @db.VarChar(128)
  deliveryStatus     ChatMessageDeliveryStatus @default(delivered) @map("delivery_status")
  deliveryErrorCode  String?                   @map("delivery_error_code") @db.VarChar(80)
  createdAt          DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)

  shop            Shop             @relation(fields: [shopId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  session         ChatSession      @relation(fields: [chatSessionId, shopId], references: [id, shopId], onDelete: Restrict, onUpdate: Restrict)
  actorAdmin      AdminUser?       @relation(fields: [actorAdminUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  outboundMessage OutboundMessage?

  @@unique([chatSessionId, idempotencyKey], map: "chat_messages_session_idem_key")
  @@index([chatSessionId, createdAt, id], map: "chat_messages_session_created_idx")
  @@map("chat_messages")
}

model ChatNote {
  id                String   @id @default(uuid()) @db.Uuid
  shopId            String   @map("shop_id") @db.Uuid
  chatSessionId     String   @map("chat_session_id") @db.Uuid
  authorAdminUserId String   @map("author_admin_user_id") @db.Uuid
  body              String   @db.VarChar(2000)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  shop        Shop        @relation(fields: [shopId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  session     ChatSession @relation(fields: [chatSessionId, shopId], references: [id, shopId], onDelete: Restrict, onUpdate: Restrict)
  authorAdmin AdminUser   @relation(fields: [authorAdminUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([chatSessionId, createdAt, id], map: "chat_notes_session_created_idx")
  @@map("chat_notes")
}

model ChatSessionEvent {
  id               String   @id @default(uuid()) @db.Uuid
  shopId           String   @map("shop_id") @db.Uuid
  chatSessionId    String   @map("chat_session_id") @db.Uuid
  actorAdminUserId String?  @map("actor_admin_user_id") @db.Uuid
  eventType        String   @map("event_type") @db.VarChar(64)
  detail           String?  @db.VarChar(500)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  shop       Shop        @relation(fields: [shopId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  session    ChatSession @relation(fields: [chatSessionId, shopId], references: [id, shopId], onDelete: Restrict, onUpdate: Restrict)
  actorAdmin AdminUser?  @relation(fields: [actorAdminUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([chatSessionId, createdAt, id], map: "chat_session_events_session_created_idx")
  @@map("chat_session_events")
}

model ChannelIntegration {
  id                String            @id @default(uuid()) @db.Uuid
  shopId            String            @map("shop_id") @db.Uuid
  provider          String            @db.VarChar(32)
  externalAccountId String            @map("external_account_id") @db.VarChar(128)
  displayName       String            @map("display_name") @db.VarChar(120)
  status            IntegrationStatus @default(active)
  secretRef         String            @default("ENV_MESSENGER_DEFAULT") @map("secret_ref") @db.VarChar(64)
  lastWebhookAt     DateTime?         @map("last_webhook_at") @db.Timestamptz(6)
  lastErrorCode     String?           @map("last_error_code") @db.VarChar(80)
  disconnectedAt    DateTime?         @map("disconnected_at") @db.Timestamptz(6)
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  shop             Shop              @relation(fields: [shopId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  chatSessions     ChatSession[]
  outboundMessages OutboundMessage[]

  @@unique([shopId, provider], map: "channel_integrations_shop_provider_key")
  @@unique([provider, externalAccountId], map: "channel_integrations_provider_ext_account_key")
  @@map("channel_integrations")
}

model WebhookEvent {
  id                String             @id @default(uuid()) @db.Uuid
  shopId            String?            @map("shop_id") @db.Uuid
  provider          String             @db.VarChar(32)
  providerEventId   String             @map("provider_event_id") @db.VarChar(160)
  externalAccountId String             @map("external_account_id") @db.VarChar(128)
  status            WebhookEventStatus @default(processed)
  retryCount        Int                @default(0) @map("retry_count")
  errorCode         String?            @map("error_code") @db.VarChar(80)
  receivedAt        DateTime           @default(now()) @map("received_at") @db.Timestamptz(6)
  processedAt       DateTime?          @map("processed_at") @db.Timestamptz(6)

  shop Shop? @relation(fields: [shopId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([provider, providerEventId], map: "webhook_events_provider_event_key")
  @@index([shopId, receivedAt(sort: Desc)], map: "webhook_events_shop_received_idx")
  @@map("webhook_events")
}

model OutboundMessage {
  id                  String                @id @default(uuid()) @db.Uuid
  shopId              String                @map("shop_id") @db.Uuid
  integrationId       String                @map("integration_id") @db.Uuid
  chatSessionId       String                @map("chat_session_id") @db.Uuid
  chatMessageId       String                @unique(map: "outbound_messages_chat_message_key") @map("chat_message_id") @db.Uuid
  recipientExternalId String                @map("recipient_external_id") @db.VarChar(128)
  status              OutboundMessageStatus @default(pending)
  attemptCount        Int                   @default(0) @map("attempt_count")
  maxAttempts         Int                   @default(3) @map("max_attempts")
  nextAttemptAt       DateTime              @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
  providerMessageId   String?               @map("provider_message_id") @db.VarChar(128)
  lastErrorCode       String?               @map("last_error_code") @db.VarChar(80)
  sentAt              DateTime?             @map("sent_at") @db.Timestamptz(6)
  createdAt           DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  shop        Shop               @relation(fields: [shopId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  integration ChannelIntegration @relation(fields: [integrationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  session     ChatSession        @relation(fields: [chatSessionId, shopId], references: [id, shopId], onDelete: Restrict, onUpdate: Restrict)
  chatMessage ChatMessage        @relation(fields: [chatMessageId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([status, nextAttemptAt], map: "outbound_messages_status_next_idx")
  @@index([shopId, createdAt(sort: Desc)], map: "outbound_messages_shop_created_idx")
  @@map("outbound_messages")
}

model ShopMembership {
  id        String               @id @default(uuid()) @db.Uuid
  shopId    String               @map("shop_id") @db.Uuid
  adminUserId String             @map("admin_user_id") @db.Uuid
  role      ShopMemberRole       @default(staff)
  status    ShopMembershipStatus @default(active)
  revokedAt DateTime?            @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  shop      Shop      @relation(fields: [shopId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  adminUser AdminUser @relation("UserMemberships", fields: [adminUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([shopId, adminUserId], map: "shop_memberships_shop_user_key")
  @@index([adminUserId, status], map: "shop_memberships_user_status_idx")
  @@map("shop_memberships")
}

model ShopInvitation {
  id              String         @id @default(uuid()) @db.Uuid
  shopId          String         @map("shop_id") @db.Uuid
  emailNormalized String         @map("email_normalized") @db.VarChar(254)
  role            ShopMemberRole @default(staff)
  tokenHash       Bytes          @unique(map: "shop_invitations_token_hash_key") @map("token_hash") @db.ByteA
  invitedByUserId String         @map("invited_by_user_id") @db.Uuid
  expiresAt       DateTime       @map("expires_at") @db.Timestamptz(6)
  acceptedAt      DateTime?      @map("accepted_at") @db.Timestamptz(6)
  revokedAt       DateTime?      @map("revoked_at") @db.Timestamptz(6)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  shop      Shop      @relation(fields: [shopId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  invitedBy AdminUser @relation("InvitedByAdmin", fields: [invitedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([shopId, createdAt(sort: Desc)], map: "shop_invitations_shop_created_idx")
  @@map("shop_invitations")
}

model AuditLog {
  id               String   @id @default(uuid()) @db.Uuid
  shopId           String   @map("shop_id") @db.Uuid
  actorAdminUserId String?  @map("actor_admin_user_id") @db.Uuid
  action           String   @db.VarChar(80)
  targetType       String   @map("target_type") @db.VarChar(64)
  targetId         String?  @map("target_id") @db.VarChar(128)
  summary          String?  @db.VarChar(500)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  shop       Shop       @relation(fields: [shopId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  actorAdmin AdminUser? @relation(fields: [actorAdminUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([shopId, createdAt(sort: Desc), id(sort: Desc)], map: "audit_logs_shop_created_idx")
  @@map("audit_logs")
}

model AiInteractionLog {
  id                    String               @id @default(uuid()) @db.Uuid
  shopId                String               @map("shop_id") @db.Uuid
  chatSessionId         String               @map("chat_session_id") @db.Uuid
  channel               ChatChannel
  customerQueryPreview  String               @map("customer_query_preview") @db.VarChar(300)
  replyPreview          String               @map("reply_preview") @db.VarChar(500)
  outcome               AiInteractionOutcome
  confidence            Float?
  promptTokens          Int                  @default(0) @map("prompt_tokens")
  completionTokens      Int                  @default(0) @map("completion_tokens")
  estimatedCostMicroUsd BigInt               @default(0) @map("estimated_cost_micro_usd")
  model                 String?              @db.VarChar(80)
  createdAt             DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([shopId, createdAt(sort: Desc)], map: "ai_interaction_logs_shop_created_idx")
  @@map("ai_interaction_logs")
}
